# Copy to backend/.env — see the root .env.example for full comments.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/job_search_agent
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GREENHOUSE_BOARDS=
LEVER_SITES=
MAX_UPLOAD_MB=5
MATCH_CACHE_DAYS=14
