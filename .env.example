# Copy this file to backend/.env and fill in the values you have.
# The app still runs without optional API keys: Remotive stays enabled,
# and matching falls back to a deterministic heuristic scorer.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/job_search_agent
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# gemini | heuristic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# Optional Adzuna job search API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional Google Programmable Search (public job-board domains only)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional comma-separated Greenhouse board tokens and Lever site slugs
GREENHOUSE_BOARDS=
LEVER_SITES=

MAX_UPLOAD_MB=5
MATCH_CACHE_DAYS=14
